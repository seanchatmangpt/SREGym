{%- set problems = sparql(query="PREFIX sre: <https://seanchatmangpt.github.io/SREGym/ontology#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?id ?runtimeId ?application ?layer ?family ?order WHERE { ?problem a sre:BenchmarkProblem ; dcterms:identifier ?id ; sre:runtimeProblemId ?runtimeId ; sre:application ?application ; sre:faultLayer ?layer ; sre:faultFamily ?family ; sre:order ?order ; dcterms:isPartOf sre:sregym-lite . } ORDER BY ?order") -%}
"""GENERATED by ggen from ggen/sregym.ttl. Do not edit by hand."""

SREGYM_LITE_PROBLEMS = (
{%- for row in problems %}
    {{ row.runtimeId | json_encode() }},
{%- endfor %}
)

PROBLEM_METADATA = {
{%- for row in problems %}
    {{ row.runtimeId | json_encode() }}: {
        "ontology_id": {{ row.id | json_encode() }},
        "application": {{ row.application | json_encode() }},
        "fault_layer": {{ row.layer | json_encode() }},
        "fault_family": {{ row.family | json_encode() }},
    },
{%- endfor %}
}
